# ============================================================
# micro-apps-hub — 環境変数サンプル
# このファイルをコピーして .env.local を作成してください
# cp .env.local.example .env.local
# ============================================================

# ---- アプリ設定 -----------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Supabase -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ---- Stripe -------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- OGP / SNS 投稿用デフォルト画像 --------------------------
# /api/og/{slug} エンドポイントが自動生成する OGP 画像の URL
MICRO_APPS_DEFAULT_IMAGE_URL="http://localhost:3000/api/og/tetris"

# ---- TimesFM AI 予測 (オプション) ----------------------------
# Hugging Face Spaces にデプロイ後に設定
# デプロイ方法: bash timesfm-server/deploy-to-hf.sh <HF_USERNAME>
# TIMESFM_API_URL="https://<HF_USERNAME>-timesfm-server.hf.space"

# ============================================================
# GitHub Actions 用 Secrets (リポジトリ Settings で設定)
# ============================================================
# NOTE_SESSION           - Note.com の __session クッキー値
# INSTAGRAM_ACCESS_TOKEN - Instagram Graph API 長期アクセストークン
# INSTAGRAM_USER_ID      - Instagram ビジネスアカウントの数値 ID
